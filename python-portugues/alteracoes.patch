+/* PYTHON_PT_NATIVE_KEYWORDS: português apenas em arquivos .ptpy. */
+static int
+_python_pt_source(Parser *p)
+{
+    PyObject *filename = p->tok->filename;
+    if (filename == NULL || !PyUnicode_Check(filename)) return 0;
+    Py_ssize_t length = PyUnicode_GET_LENGTH(filename);
+    const char *suffix = ".ptpy";
+    if (length < 5) return 0;
+    for (int i = 0; i < 5; i++) {
+        if (PyUnicode_READ_CHAR(filename, length - 5 + i) != (unsigned char)suffix[i])
+            return 0;
+    }
+    return 1;
+}
+
+static const char *
+_python_pt_keyword(const char *text, Py_ssize_t length)
+{
+    static const struct { const char *pt; const char *en; } words[] = {
+        {"Falso", "False"},
+        {"Nenhum", "None"},
+        {"Verdadeiro", "True"},
+        {"e", "and"},
+        {"como", "as"},
+        {"afirme", "assert"},
+        {"ass\303\255ncrono", "async"},
+        {"assincrono", "async"},
+        {"aguarde", "await"},
+        {"interrompa", "break"},
+        {"classe", "class"},
+        {"continue", "continue"},
+        {"fun\303\247\303\243o", "def"},
+        {"funcao", "def"},
+        {"defina", "def"},
+        {"apague", "del"},
+        {"sen\303\243ose", "elif"},
+        {"senaose", "elif"},
+        {"sen\303\243o", "else"},
+        {"senao", "else"},
+        {"exceto", "except"},
+        {"finalmente", "finally"},
+        {"para", "for"},
+        {"de", "from"},
+        {"global", "global"},
+        {"se", "if"},
+        {"importe", "import"},
+        {"em", "in"},
+        {"\303\251", "is"},
+        {"eh", "is"},
+        {"lambda", "lambda"},
+        {"n\303\243olocal", "nonlocal"},
+        {"naolocal", "nonlocal"},
+        {"n\303\243o", "not"},
+        {"nao", "not"},
+        {"ou", "or"},
+        {"passe", "pass"},
+        {"lance", "raise"},
+        {"retorne", "return"},
+        {"tente", "try"},
+        {"enquanto", "while"},
+        {"com", "with"},
+        {"produza", "yield"},
+        {NULL, NULL}
+    };
+    for (int i = 0; words[i].pt != NULL; i++) {
+        if ((Py_ssize_t)strlen(words[i].pt) == length &&
+            memcmp(words[i].pt, text, (size_t)length) == 0)
+            return words[i].en;
+    }
+    return NULL;
+}
